<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <application
        android:name=".EpicuriusApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.App"
        tools:targetApi="31">
        <activity
            android:name=".ui.screens.auth.login.LoginActivity"
            android:exported="false"
            android:label="Login"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.auth.resetPassword.ResetPasswordActivity"
            android:exported="false"
            android:label="Reset Password"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.auth.signup.SignUpActivity"
            android:exported="false"
            android:label="Sign Up"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.dailyMenu.DailyMenuActivity"
            android:exported="false"
            android:label="Daily Menu"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.collections.favourites.FavouritesActivity"
            android:exported="false"
            android:label="Favourites Folder"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.collections.list.FavouritesListActivity"
            android:exported="false"
            android:label="Favourites List"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.fridge.FridgeActivity"
            android:exported="false"
            android:label="Fridge"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.mealPlanner.calendar.CalendarActivity"
            android:exported="false"
            android:label="Meal Planner Calendar"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.mealPlanner.daily.DailyActivity"
            android:exported="false"
            android:label="Meal Planner Daily"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.mealPlanner.search.MealPlannerSearchActivity"
            android:exported="false"
            android:label="Meal Planner Search"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.mealPlanner.weekly.WeeklyActivity"
            android:exported="false"
            android:label="Meal Planner Weekly"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.recipe.createRecipe.CreateRecipeActivity"
            android:exported="false"
            android:label="Create Recipe"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.recipe.ingredients.ConfirmIngredientsActivity"
            android:exported="false"
            android:label="Confirm Ingredients"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.recipe.preparation.PreparationActivity"
            android:exported="false"
            android:label="Preparation"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.recipe.profile.RecipeProfileActivity"
            android:exported="false"
            android:label="Recipe Profile"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.search.general.SearchActivity"
            android:exported="false"
            android:label="Search"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.search.camera.CameraActivity"
            android:exported="true"
            android:label="Camera"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.user.follow.FollowActivity"
            android:exported="false"
            android:label="Follow"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.user.preferences.lists.PreferencesActivity"
            android:exported="false"
            android:label="Preferences"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.user.preferences.skipable.KnowMoreActivity"
            android:exported="false"
            android:label="Know More"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.user.profile.UserProfileActivity"
            android:exported="false"
            android:label="User Profile"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.user.settings.SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.serverOffline.ServerOfflineActivity"
            android:exported="false"
            android:label="ConnectionTimeout"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App" />
        <activity
            android:name=".ui.screens.feed.FeedActivity"
            android:exported="true"
            android:label="Feed"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>